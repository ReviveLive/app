# Secrets — NEVER commit. Holds the site password hash and DB credentials.
# Covers .env AND per-instance files like .env.real (local real-data stack),
# but keeps the committed template .env.example.
.env
.env.*
!.env.example

# Machine-local env overrides (Vite convention). E.g. frontend/.env.local sets
# VITE_API_BASE for a local Tailscale setup — specific to one machine.
.env.local
*.local

# Personal data — real vehicle locations. Must never enter git history.
# The glob also covers the real-data stack's own folders (incoming-real/, etc.).
incoming*/
processed*/

# The database itself (same personal data) and build/runtime junk.
pgdata/
node_modules/
.venv/
__pycache__/
*.pyc

# Frontend build output (regenerated by the Docker build).
frontend/dist/

# mkdocs build output (regenerated by `mkdocs build`).
site/

# OS / editor noise
.DS_Store
Thumbs.db
.vscode/

# Machine-local Claude Code settings (per-developer, not shared).
.claude/settings.local.json

# Local dev DB port override — not for the deployed stack.
docker-compose.override.yml
dev/