# Copy this file to ".env" (in this same folder) and fill in the real values.
#   cp .env.example .env
# .env holds secrets — it must never be committed to git.

# The public address of the demo. A subdomain of your work domain is ideal,
# e.g. revive-demo.rei-limited.com  (Caddy uses it to get the HTTPS certificate).
# For a quick LOCAL test before DNS is ready, set this to exactly:  localhost
DOMAIN=revive-demo.example.com

# The login shown to anyone who opens the site (a browser password box).
BASIC_AUTH_USER=demo

# NOT the password itself — a HASH of it, with every "$" doubled to "$$".
# Generate it on the server (one line) and paste the output below:
#   docker run --rm caddy caddy hash-password --plaintext 'your-strong-password' | sed 's/\$/\$\$/g'
BASIC_AUTH_HASH=

# Database password. It is internal-only, but still make it long and random.
# Use letters and numbers (avoid "$" here to keep things simple).
POSTGRES_PASSWORD=change-this-to-a-long-random-string

# These rarely need changing.
POSTGRES_USER=revive
POSTGRES_DB=revive_pilot
