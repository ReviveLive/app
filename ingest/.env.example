# Copy to ".env" in this folder and fill in.
#   cp .env.example .env
# Holds secrets — never commit .env.

# Where the ingest API's own database lives. Point this at whatever host
# you pick from the README's options — a local Docker Postgres for a first
# test, or a real one once hosting is decided.
POSTGRES_USER=revive
POSTGRES_PASSWORD=change-this-to-a-long-random-string
POSTGRES_DB=revive_ingest
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# One-off scripts (load_netbiter_catalog.py, inspect_netbiter_system.py, ...)
# need to point at the REAL Railway database, not the local one above - set
# this to Railway's connection string so they pick it up automatically,
# instead of setting $env:DATABASE_URL by hand every shell session.
# RAILWAY_DB_URL=

# The bearer token every unit's warrior.cfg must send:
#   INGEST_HDR=Authorization=Bearer <this value>
# Leave blank ONLY for a first local test with nothing internet-facing.
# Required before this is reachable by a real device over the internet.
INGEST_TOKEN=

# GPS comes from a separate Netbiter-connected device per truck, not the
# Flexy 205 — see README.md's "Netbiter GPS" section and app/poll_netbiter.py.
# Get this from the contractor / your Netbiter (Argos) account.
NETBITER_ACCESS_KEY=
# Defaults shown; only override if you have a reason to.
# NETBITER_BASE_URL=https://api.netbiter.net/operation/v1/rest/json
# Standard interval only - used while a vehicle is stationary/state-unknown;
# a faster, separate interval applies automatically while moving, and a
# confirmed-off vehicle isn't polled at all. See ingest/polling-rate.md.
# NETBITER_POLL_INTERVAL_SECONDS=300
